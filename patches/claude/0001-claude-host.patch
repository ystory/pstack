+      executor: 'claude-code',
+      action: 'install',
+      command: 'curl -fsSL https://claude.ai/install.sh | bash',
+      url: 'https://code.claude.com/docs/en/setup',
+    });
+  else if (native.auth.loggedIn === false)
+    guidance.push({
+      executor: 'claude-code',
+      action: 'login',
+      command: 'claude auth login',
+      interactiveCommand: '/login',
+      url: 'https://code.claude.com/docs/en/authentication',
+    });
+  if (!codex.cli?.available)
+    guidance.push({
+      executor: 'codex',
+      action: 'optional-install',
+      command: 'npm install -g @openai/codex',
+      url: 'https://developers.openai.com/codex/cli',
+      requiredFor: 'Codex workers only',
+    });
+  else if (codex.auth?.loggedIn === false)
+    guidance.push({
+      executor: 'codex',
+      action: 'login',
+      command: 'codex login',
+      headlessCommand: 'codex login --device-auth',
+      url: 'https://learn.chatgpt.com/docs/auth',
+      requiredFor: 'Codex workers only',
+    });
