+    if (seen.has(key))
+      throw new Error(`Duplicate catalog model: ${executor} ${model}`);
+    seen.add(key);
+    return {
+      executor,
+      model,
+      supportedReasoningEfforts: [...new Set(supportedReasoningEfforts)],
+      ...(entry.source
+        ? {
+            source: {
+              kind: entry.source.kind,
+              description: entry.source.description,
+            },
+          }
