+    schemaVersion: 1,
+    node: {
+      executable: process.execPath,
+      version: process.version,
+      available: true,
+    },
+    claude: native,
+    codex,
+    guidance,
+    authentication: {
+      chatgpt: 'Codex ChatGPT subscription login uses the account plan.',
+      apiKey:
+        'Codex API-key login uses OpenAI API billing. Never paste a key into setup output.',
+    },
+  };
+});
