@@ -0,0 +1,18 @@
+# Claude history
+
+Use the current conversation or an explicit state capsule before searching stored history. Scope recall to the active project, its Git worktrees, the named topic, and the requested time window. Do not read unrelated projects.
+
+Claude Code stores local transcripts under `${CLAUDE_CONFIG_DIR:-~/.claude}/projects/`. A project directory uses the absolute checkout path with non-alphanumeric characters replaced by `-`. Main session files are `<session-id>.jsonl`; child transcripts live under `<session-id>/subagents/`. These files are host runtime data, so confirm the active session ID or opening user message. The newest file alone does not establish the active conversation.
+
+Resolve the helper from this installed skill and use an absolute project path:
+
+```sh
+node "<recall>/scripts/claude-history.mjs" list --project "/absolute/project"
+node "<recall>/scripts/claude-history.mjs" read --project "/absolute/project" --id "<exact-session-id>"
+```
+
+`list` returns session metadata ordered by actual modification time. It searches only the active repository's registered worktree directories and verifies each transcript's `cwd` ownership. `read` rejects an ID outside that project and returns the main records plus its scoped child transcripts. `--touching "/absolute/worktree"` narrows either command to that worktree. `--claude-home "/absolute/fixture-home"` selects an isolated test home. It neither edits history nor searches every user's project directory.
+
+Parse user and assistant `message.content`, tool calls and results, session IDs, and timestamps. Skip this session and obvious eval or test chats when recalling earlier work. Read the complete relevant transcript when the answer depends on what an agent actually read, ran, or changed. For a selected Codex worker, also inspect its exact run directory and receipt from Claude Code execution. Claude child logs do not contain the external Codex thread's full execution evidence.
+
+When the active transcript cannot be matched, use a tight conversation digest and disclose that limit. Do not broaden the search to unrelated projects. A checkpoint is prior context, not proof of current code or process state.
diff --git a/skills/recall/scripts/claude-history.mjs b/skills/recall/scripts/claude-history.mjs
new file mode 100755
index 0000000..74f445d
--- /dev/null
+++ b/skills/recall/scripts/claude-history.mjs
@@ -0,0 +1,225 @@
+#!/usr/bin/env node
+import { execFileSync } from 'node:child_process';
+import { lstat, readdir, readFile, realpath } from 'node:fs/promises';
+import { homedir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+function options(args) {
+  const command = args.shift();
+  if (!['list', 'read'].includes(command)) throw new Error('Use list or read.');
+  const result = { command };
+  while (args.length) {
+    const key = args.shift();
+    if (!['--project', '--claude-home', '--id', '--touching'].includes(key))
+      throw new Error(`Unknown option ${key}.`);
+    const value = args.shift();
+    if (!value || value.startsWith('--'))
+      throw new Error(`${key} needs a value.`);
+    if (result[key.slice(2)]) throw new Error(`Duplicate option ${key}.`);
+    result[key.slice(2)] = value;
+  }
+  if (!path.isAbsolute(result.project ?? ''))
+    throw new Error('--project must be absolute.');
+  if (result['claude-home'] && !path.isAbsolute(result['claude-home']))
+    throw new Error('--claude-home must be absolute.');
+  if (result.command === 'read' && !/^[a-zA-Z0-9_-]+$/.test(result.id ?? ''))
+    throw new Error('read needs a session --id.');
+  if (result.touching && !path.isAbsolute(result.touching))
+    throw new Error('--touching must be absolute.');
+  return result;
+}
+
+async function physical(directory) {
+  return realpath(directory);
+}
+
+async function projectDirectories(project) {
+  const resolved = await physical(project);
+  try {
+    const output = execFileSync(
+      'git',
+      [
+        '-C',
+        resolved,
+        '-c',
+        'core.quotePath=false',
+        'worktree',
+        'list',
+        '--porcelain',
+        '-z',
+      ],
+      { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] },
+    );
+    const worktrees = output
+      .split('\0')
+      .filter((line) => line.startsWith('worktree '))
+      .map((line) => line.slice(9));
+    return [
+      ...new Set([resolved, ...(await Promise.all(worktrees.map(physical)))]),
+    ];
+  } catch {
+    return [resolved];
+  }
+}
+
+function projectSlug(directory) {
+  return directory.replace(/[^a-zA-Z0-9]/g, '-');
+}
+
+async function regular(file) {
+  try {
+    const info = await lstat(file);
+    return info.isFile() && !info.isSymbolicLink() ? info : undefined;
+  } catch (error) {
+    if (error.code === 'ENOENT') return undefined;
+    throw error;
+  }
+}
+
+async function records(file) {
+  const output = [];
+  for (const [index, line] of (await readFile(file, 'utf8'))
+    .split('\n')
+    .entries()) {
+    if (!line.trim()) continue;
+    try {
+      output.push(JSON.parse(line));
+    } catch {
+      output.push({ type: 'unparsed-line', lineNumber: index + 1, raw: line });
+    }
+  }
+  return output;
+}
+
+async function sessions(home, projects) {
+  const found = [];
+  for (const project of projects) {
+    const directory = path.join(home, 'projects', projectSlug(project));
+    try {
+      if (
+        !(await lstat(directory)).isDirectory() ||
+        (await lstat(directory)).isSymbolicLink()
+      )
+        continue;
+    } catch (error) {
+      if (error.code === 'ENOENT') continue;
+      throw error;
+    }
+    for (const entry of await readdir(directory, { withFileTypes: true })) {
+      if (!entry.isFile() || !/^[a-zA-Z0-9_-]+\.jsonl$/.test(entry.name))
+        continue;
+      const file = path.join(directory, entry.name);
+      const info = await regular(file);
+      if (!info) continue;
+      const rows = await records(file);
+      const id = path.basename(entry.name, '.jsonl');
+      const owners = new Set();
+      let foreign = false;
+      for (const row of rows) {
+        if (typeof row.cwd !== 'string' || !path.isAbsolute(row.cwd)) continue;
+        try {
+          const owner = await physical(row.cwd);
+          if (!projects.includes(owner)) foreign = true;
+          owners.add(owner);
+        } catch {
+          foreign = true;
+        }
+      }
+      if (foreign || !owners.size) continue;
+      if (
+        rows.some(
+          (row) => typeof row.sessionId === 'string' && row.sessionId !== id,
+        )
+      )
+        continue;
+      const timestamp = rows.find(
+        (row) => typeof row.timestamp === 'string',
+      )?.timestamp;
+      found.push({
+        id,
+        file,
+        projects: [...owners],
+        modified: info.mtime.toISOString(),
+        timestamp,
+        rows,
+      });
+    }
+  }
+  return found.sort(
+    (a, b) => b.modified.localeCompare(a.modified) || a.id.localeCompare(b.id),
+  );
+}
+
+function metadata(session) {
+  const { rows, ...value } = session;
+  return value;
+}
+
+export async function run(args) {
+  const config = options([...args]);
+  const home = await physical(
+    config['claude-home'] ??
+      process.env.CLAUDE_CONFIG_DIR ??
+      path.join(homedir(), '.claude'),
+  );
+  const projects = await projectDirectories(config.project);
+  const touching = config.touching
+    ? await physical(config.touching)
+    : undefined;
+  if (touching && !projects.includes(touching))
+    throw new Error('--touching is outside the project worktrees.');
+  const selected = (await sessions(home, projects)).filter(
+    (session) => !touching || session.projects.includes(touching),
+  );
+  if (config.command === 'list') return selected.map(metadata);
+  const session = selected.find((item) => item.id === config.id);
+  if (!session) throw new Error('No matching session owned by this project.');
+  const subagents = [];
+  const parent = path.join(path.dirname(session.file), session.id);
+  const directory = path.join(parent, 'subagents');
+  try {
+    if ((await lstat(parent)).isSymbolicLink())
+      throw new Error('Session transcript directory is a symlink.');
+    if ((await lstat(directory)).isSymbolicLink())
+      throw new Error('Subagent transcript directory is a symlink.');
+    for (const entry of await readdir(directory, { withFileTypes: true })) {
+      const file = path.join(directory, entry.name);
+      if (
+        !entry.isFile() ||
+        !entry.name.endsWith('.jsonl') ||
+        !(await regular(file))
+      )
+        continue;
+      const rows = await records(file);
+      let foreign = false;
+      for (const row of rows) {
+        if (typeof row.cwd !== 'string') continue;
+        try {
+          if (!projects.includes(await physical(row.cwd))) foreign = true;
+        } catch {
+          foreign = true;
+        }
+      }
+      if (!foreign) subagents.push({ file, records: rows });
+    }
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+  }
+  return { ...metadata(session), records: session.rows, subagents };
+}
+
+if (
+  process.argv[1] &&
+  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+) {
+  try {
+    const result = await run(process.argv.slice(2));
+    if (Array.isArray(result))
+      for (const item of result) console.log(JSON.stringify(item));
+    else console.log(JSON.stringify(result));
+  } catch (error) {
+    console.error(error.message);
+    process.exitCode = 1;
+  }
+}
