+			</dev/null 2>/dev/null || echo "warn: could not read PR state for $b; verify before pruning" >&2
+	done > "$rest_prs"
+	jq -s --arg me "$me" '[add // [] | .[] | select(.login == $me) | {number, state, head}]' \
+		"$rest_prs" > "$prs" 2>/dev/null
 fi
 [ -s "$prs" ] || echo "[]" > "$prs"
 
