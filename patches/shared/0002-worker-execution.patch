+    effectiveEffort: null,
+    inputSent: outcome?.inputSent ?? false,
+    identityBeforeInput: outcome?.identityBeforeInput ?? false,
+    result: error ? null : (evidence.terminalResult?.response ?? null),
+    usage: evidence.terminalResult?.usage
