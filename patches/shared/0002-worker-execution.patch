+          scope: 'conversation-cumulative',
+          source: 'native-agy-result',
+          value: evidence.terminalResult.usage,
+        }
+      : null,
+    ...(catalog
+      ? { catalogPath: path.join(options.runDir, 'catalog.json'), ...catalog }
+      : {}),
+    completedAt: new Date().toISOString(),
