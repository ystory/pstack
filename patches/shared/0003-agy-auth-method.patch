+  } catch {}
+  const [method] = authMethods.find(([, applies]) =>
+    applies({ modelProvider }),
+  );
+  return {
+    method,
+    modelProvider,
+    geminiApiKeyPresent: Boolean(process.env.GEMINI_API_KEY),
+    verified: false,
+  };
+}
